# ---- کلید دیپ‌سیک (اختیاری؛ می‌توانید آن را از «پنل ← تنظیمات دیپ‌سیک» هم وارد کنید) ----
# از https://platform.deepseek.com/api_keys بسازید
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- حساب کاربری اولیه (فقط یک بار برای ساخت اولین حساب خوانده می‌شود) ----
# بعد از ورود، از «پنل ← حساب کاربری» نام کاربری/شماره موبایل/رمز عبور را تغییر دهید.
APP_USERNAME=admin
APP_MOBILE=09120000000
APP_PASSWORD=admin1234

# ---- ذخیره‌سازی دائمی تنظیمات روی Vercel (توصیه‌شده) ----
# یک دیتابیس Redis (Vercel KV یا Upstash) به پروژه وصل کنید؛ این دو متغیر خودکار تنظیم می‌شوند:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- کلیدهای اختیاری سرویس‌های تبدیل فایل به Markdown ----
# این‌ها را می‌توانید در پنل هم وارد کنید:
# DATALAB_API_KEY=            # https://www.datalab.to  (Marker)
# MISTRAL_API_KEY=            # https://console.mistral.ai  (OCR)
# JINA_API_KEY=               # https://jina.ai  (برای Jina Reader لازم نیست: رایگان است)
