# کلید API دیپ‌سیک (اجباری) — از https://platform.deepseek.com/api_keys بسازید
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آدرس سرویس (اختیاری)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# مدل پیش‌فرض (اختیاری): deepseek-chat یا deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# رمز دسترسی سایت (اختیاری ولی توصیه‌شده)
# اگر مقدار بگذارید، هر کاربر باید این رمز را در برنامه وارد کند تا بتواند
# از کلید API شما استفاده کند. اگر خالی باشد، هر کسی که آدرس سایت را داشته
# باشد می‌تواند اعتبار حساب دیپ‌سیک شما را مصرف کند.
APP_PASSWORD=
